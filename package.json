{
  "name": "x402ai-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server that lets an AI client buy embed, summarize and ask calls from api.x402ai.dev via x402 (USDC on Base), with per-payment and per-session spend caps.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "x402ai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "x402",
    "usdc",
    "base",
    "payments"
  ],
  "author": "Landy Ukena",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukenal/x402ai-mcp.git"
  },
  "homepage": "https://github.com/ukenal/x402ai-mcp#readme",
  "bugs": {
    "url": "https://github.com/ukenal/x402ai-mcp/issues"
  }
}
